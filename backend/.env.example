# GuitarTab AI backend — configuration example.
# Copy to `backend/.env` and adjust for your machine. All values are optional;
# defaults are safe for local development.

# Runtime environment label (development / test / production)
GUITARTAB_ENVIRONMENT=development

# Directory where uploaded videos and job metadata are stored.
# Defaults to <repo>/data/uploads when unset.
#GUITARTAB_UPLOAD_DIR=C:\guitartab-ai-data\uploads

# Maximum accepted upload size, in megabytes.
GUITARTAB_MAX_UPLOAD_SIZE_MB=100

# Uploads older than this many days are eligible for cleanup
# (see scripts/cleanup_uploads.py). Set to 0 to disable timed cleanup.
GUITARTAB_KEEP_UPLOADS_DAYS=30

# Comma-separated list of browser origins permitted to call the API.
GUITARTAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173